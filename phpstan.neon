includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app

    level: 5

    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # env() en comando de staging es intencional (la config no se cachea ahí)
        -
            message: '#Called .env. outside of the config directory#'
            path: app/Console/Commands/SanitizeStagingData.php

        # Dead catch: PDO wrapping de QueryException depende del driver/configuración
        - '#Dead catch - Illuminate\\Database\\QueryException is never thrown in the try block#'

        # getPageName() existe en la clase concreta pero no en el contrato LengthAwarePaginator
        - '#Call to an undefined method Illuminate\\Contracts\\Pagination\\LengthAwarePaginator::getPageName\(\)#'

        # Multi-sort con closures que PHPStan no puede verificar estáticamente
        - '#Parameter \#1 \$callback of method Illuminate\\Support\\Collection.*::sortBy\(\) expects#'

        # Array shapes de getimagesize() cuyos offsets PHPStan siempre considera definidos
        - '#Offset [01] on array\{0: int<0, max>.*\} in isset\(\) always exists and is not nullable#'

        # Valores en arrays tipados estáticamente que PHPStan sabe que siempre existen
        - '#Offset .+ on array\{.+\} on left side of \?\? always exists and is not nullable#'
        - '#Offset .+ on array\{.+\} in isset\(\) always exists and is not nullable#'

        # Check defensivo de instanceof ya tipado como Request
        - '#Instanceof between Illuminate\\Http\\Request and Illuminate\\Http\\Request will always evaluate to true#'

        # is_null sobre tipo no-nullable conocido
        - '#Call to function is_null\(\) with .* will always evaluate to false#'

        # Comparación con array vacío contra lista no vacía conocida
        - '#Strict comparison using === between non-empty-list<.*> and array\{\} will always evaluate to false#'

        # Mismatch de float|int vs float en normalización de variantes (aritmética PHP)
        - '#Method App\\Modules\\Catalog\\Services\\ProductVariantSyncService::normalizeRows\(\) should return#'

        # Tipos mixed en variant/variant_label del carrito (inferencia compleja de sesión)
        - '#Method App\\Modules\\Orders\\Services\\Cart\\CartService::items\(\) should return#'

        # buildRows retorna category/variant como mixed (viene de relaciones eager-loaded)
        - '#Method App\\Modules\\Admin\\Services\\InventoryPdfGenerator::buildRows\(\) should return#'

        # Comparación always true en operaciones de porcentaje con constante 0.13
        - '#Comparison operation ">" between 0\.13 and -1 is always true#'
