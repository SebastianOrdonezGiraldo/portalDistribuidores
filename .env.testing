# =============================================================================
# .env.testing — Portal Distribuidores
# Configuración de entorno para el conjunto de pruebas PHPUnit / Laravel.
#
# Este archivo es leído automáticamente por phpunit.xml cuando se define
# <env name="..." /> o cuando TestCase::withEnvironmentVariables() está activo.
# Los valores aquí se sobreescriben con los definidos en phpunit.xml.
# =============================================================================

APP_NAME="Portal de Distribuidores (Testing)"
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Bogota

AUTH_ALLOW_PUBLIC_REGISTRATION=true

# ── BASE DE DATOS ─────────────────────────────────────────────────────────────
# SQLite en memoria para velocidad máxima en tests
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# ── CACHE / SESSION / QUEUE ───────────────────────────────────────────────────
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null

# ── MAIL ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=array

# ── ALMACENAMIENTO ────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
PRIVATE_DISK_DRIVER=local

# ── SERVICIOS EXTERNOS (deshabilitados en tests) ──────────────────────────────
SCOUT_MONITOR_ENABLED=false
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

# ── SEGURIDAD ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=4

# ── LOGS ──────────────────────────────────────────────────────────────────────
LOG_CHANNEL=null
LOG_LEVEL=debug
