        },
        {
          "name": "03 - Agregar al Carrito",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_token", "value": "{{csrf_token}}", "type": "text" },
                { "key": "product_id", "value": "{{product_id}}", "type": "text" },
                { "key": "qty", "value": "1", "type": "text" },
                { "key": "unit_label", "value": "unidad", "type": "text" }
              ]
            },
            "url": "{{base_url}}/cart"
          }
        },
        {
          "name": "04 - Checkout (CSRF)",
          "event": [
