{
  "info": {
    "_postman_id": "d4c9af5b-6f0e-463d-a6b7-portal-distribuidores",
    "name": "Portal Distribuidores - Import Corporal Medical SAS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "csrf_token", "value": "" },
    { "key": "admin_email", "value": "" },
    { "key": "admin_password", "value": "" },
    { "key": "dist_email", "value": "" },
    { "key": "dist_password", "value": "" },
    { "key": "product_id", "value": "1" },
    { "key": "order_id", "value": "1" },
    { "key": "product_document_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "01 - Get Login (CSRF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text();",
                  "const meta = body.match(/name=\"csrf-token\" content=\"([^\"]+)\"/);",
                  "const input = body.match(/name=\"_token\" value=\"([^\"]+)\"/);",
                  "const token = (meta && meta[1]) || (input && input[1]);",
                  "if (token) { pm.collectionVariables.set('csrf_token', token); }",
                  "pm.test('csrf_token capturado', function () { pm.expect(pm.collectionVariables.get('csrf_token')).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/login"
          }
        },
        {
          "name": "02 - Login Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_token", "value": "{{csrf_token}}", "type": "text" },
                { "key": "email", "value": "{{admin_email}}", "type": "text" },
                { "key": "password", "value": "{{admin_password}}", "type": "text" }
              ]
            },
            "url": "{{base_url}}/login"
          }
        },
        {
          "name": "03 - Login Distribuidor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_token", "value": "{{csrf_token}}", "type": "text" },
                { "key": "email", "value": "{{dist_email}}", "type": "text" },
                { "key": "password", "value": "{{dist_password}}", "type": "text" }
              ]
            },
            "url": "{{base_url}}/login"
          }
        },
        {
          "name": "04 - Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_token", "value": "{{csrf_token}}", "type": "text" }
              ]
            },
            "url": "{{base_url}}/logout"
          }
        }
      ]
    },
    {
      "name": "Distribuidor",
      "item": [
        {
          "name": "01 - Catalogo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text();",
                  "const meta = body.match(/name=\"csrf-token\" content=\"([^\"]+)\"/);",
                  "if (meta && meta[1]) pm.collectionVariables.set('csrf_token', meta[1]);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/catalog"
          }
        },
        {
          "name": "02 - Ver Carrito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text();",
                  "const meta = body.match(/name=\"csrf-token\" content=\"([^\"]+)\"/);",
