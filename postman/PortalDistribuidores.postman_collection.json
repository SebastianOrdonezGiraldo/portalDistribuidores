                  "if (meta && meta[1]) pm.collectionVariables.set('csrf_token', meta[1]);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/checkout"
          }
        },
        {
          "name": "05 - Crear Orden (CTC)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_token", "value": "{{csrf_token}}", "type": "text" },
                { "key": "company_name", "value": "Distribuidor Demo SAS", "type": "text" },
                { "key": "company_nit", "value": "900123456-7", "type": "text" },
                { "key": "contact_email", "value": "compras@distribuidor-demo.com", "type": "text" },
                { "key": "contact_name", "value": "Maria Perez", "type": "text" },
                { "key": "company_address", "value": "Calle 123 # 45-67", "type": "text" },
                { "key": "city", "value": "Bogota", "type": "text" },
                { "key": "notes", "value": "Pedido creado desde Postman", "type": "text" }
              ]
            },
            "url": "{{base_url}}/orders"
          }
        },
        {
          "name": "06 - Ver Orden",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/{{order_id}}"
          }
        },
        {
          "name": "07 - Descargar Ficha Tecnica",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/documents/tech-sheet/{{product_document_id}}"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
