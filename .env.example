# =============================================================================
# .env.example — Portal Distribuidores
# Import Corporal Medical SAS
#
# Uso:
#   cp .env.example .env
#   # Editar .env con los valores reales
#   php artisan key:generate
#
# Para producción en VPS (Hostinger Ubuntu 24.04), ver DEPLOY.md
# =============================================================================

# ── APLICACIÓN ────────────────────────────────────────────────────────────────
APP_NAME="Portal de Distribuidores"
APP_ENV=local                        # staging: APP_ENV=staging | produccion: APP_ENV=production
APP_KEY=
APP_DEBUG=true                       # producción: APP_DEBUG=false
APP_ENFORCE_RUNTIME_GUARDS=false     # opcional: true solo si el entorno ya cumple todos los guardrails
APP_URL=http://127.0.0.1:8000        # staging: https://staging-pedidos.importcorporalmedical.com | produccion: https://pedidos.importcorporalmedical.com
AUTH_ALLOW_PUBLIC_REGISTRATION=true  # staging/produccion: false

# ── PROTECCION ABUSO / ANTIBOT ───────────────────────────────────────────────
ABUSE_LOGIN_PER_MINUTE=20
ABUSE_LOGIN_PER_HOUR=250
ABUSE_REGISTER_PER_HOUR=5
ABUSE_REGISTER_PER_DAY=25
ABUSE_API_GUEST_PER_MINUTE=60
ABUSE_API_AUTH_PER_MINUTE=180
ABUSE_API_GUEST_PER_HOUR=600
ABUSE_API_AUTH_PER_HOUR=3600
ABUSE_CATALOG_GUEST_PER_MINUTE=40
ABUSE_CATALOG_AUTH_PER_MINUTE=120
ABUSE_CATALOG_GUEST_PER_HOUR=450
ABUSE_CATALOG_AUTH_PER_HOUR=2400
ABUSE_AI_GUEST_PER_MINUTE=3
ABUSE_AI_AUTH_PER_MINUTE=30
ABUSE_AI_GUEST_PER_HOUR=30
ABUSE_AI_AUTH_PER_HOUR=500
ABUSE_AUTOMATION_GUARD_ENABLED=true
ABUSE_AUTOMATION_MAX_PER_MINUTE=12
ABUSE_AUTOMATION_USER_AGENTS="curl,wget,python-requests,scrapy,httpclient,libwww-perl,go-http-client,postmanruntime,powershell,axios,node-fetch"

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ── LOGS ──────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single,stderr              # producción: LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                      # producción: LOG_LEVEL=warning

# ── BASE DE DATOS (PostgreSQL) ────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=portal_distribuidores
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer                    # staging/produccion: require

SEED_DEMO_DATA=false

# Usuarios base para AccessUsersSeeder (solo desarrollo/demo)
ACCESS_USERS_ADMIN_NAME="Admin Import Corporal"
ACCESS_USERS_ADMIN_EMAIL=admin@importcorporal.test
ACCESS_USERS_ADMIN_PASSWORD=
ACCESS_USERS_DISTRIBUTOR_NAME="Usuario Distribuidor Demo"
ACCESS_USERS_DISTRIBUTOR_EMAIL=dist@importcorporal.test
ACCESS_USERS_DISTRIBUTOR_PASSWORD=

# ── SESIONES ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false          # staging/produccion: true
SESSION_PATH=/
SESSION_DOMAIN=null                  # staging: SESSION_DOMAIN=staging-pedidos.importcorporalmedical.com | produccion: SESSION_DOMAIN=pedidos.importcorporalmedical.com

# ── COLAS ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database

# ── CACHÉ ─────────────────────────────────────────────────────────────────────
CACHE_STORE=database
# CACHE_PREFIX=

# ── BROADCAST ─────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log

# ── ALMACENAMIENTO ────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# Controla qué driver usa el disco "public":
#   s3    → fuerza Cloudflare R2 (recomendado en producción)
#   local → fuerza disco local (para pruebas o si no hay R2)
#   ""    → auto-detecta: R2 en producción si AWS_BUCKET está configurado, local en dev
PUBLIC_DISK_DRIVER=                  # producción: PUBLIC_DISK_DRIVER=s3
PRIVATE_DISK_DRIVER=                 # staging/produccion: s3

# TTL en segundos para URLs firmadas de medios privados
PUBLIC_MEDIA_SIGNED_URL_TTL=20
ORDER_PDFS_DISK=private
TECH_SHEETS_DISK=private

# ── CLOUDFLARE R2 (S3-compatible) ─────────────────────────────────────────────
# Usado en producción para imágenes, documentos y cotizaciones (disco "public")
# Ver sección 13 de DEPLOY.md para instrucciones de configuración en Cloudflare
#
# Flujo: config/filesystems.php detecta APP_ENV=production + AWS_BUCKET → usa R2
# Para forzar R2 independiente del entorno: PUBLIC_DISK_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=portal-distribuidores
AWS_URL=                             # staging: URL publica del bucket portal-distribuidores-staging | produccion: URL publica del bucket portal-distribuidores
AWS_ENDPOINT=                        # staging/produccion: https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── ALMACENAMIENTO PRIVADO (R2/S3-compatible) ─────────────────────────────────
# Usado para fichas tecnicas y PDFs de pedidos que no deben ser publicos.
PRIVATE_ACCESS_KEY_ID=
PRIVATE_SECRET_ACCESS_KEY=
PRIVATE_DEFAULT_REGION=auto
PRIVATE_BUCKET=                      # staging/produccion: bucket privado para documentos protegidos
PRIVATE_ENDPOINT=                    # staging/produccion: https://ACCOUNT_ID.r2.cloudflarestorage.com
PRIVATE_USE_PATH_STYLE_ENDPOINT=true

# ── CORREO ────────────────────────────────────────────────────────────────────
# Desarrollo: MAIL_MAILER=log (los correos se guardan en storage/logs/)
# Producción: MAIL_MAILER=smtp con credenciales SMTP de Hostinger
#
# Configuración SMTP Hostinger:
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=587  (TLS)  ó  465 (SSL → MAIL_SCHEME=smtps)
#   MAIL_SCHEME=tls
MAIL_MAILER=log                      # staging: log | produccion: smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Notificaciones de pedidos nuevos
ORDER_NOTIFICATION_EMAIL_TO=                    # Destinatario(s) de alertas de pedidos
ORDER_NOTIFICATION_EMAIL_DISPATCH=sync          # staging/produccion: queue (requiere worker activo)

# ── BÚSQUEDA ──────────────────────────────────────────────────────────────────
# postgres  → búsqueda full-text nativa en PostgreSQL (recomendado, sin dependencias extra)
# meilisearch → requiere instalar Meilisearch en el servidor
SEARCH_ENGINE=postgres
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# ── DEPLOY (solo VPS) ─────────────────────────────────────────────────────────
DEPLOY_ENV_NAME=local               # staging: staging | produccion: production
DEPLOY_QUEUE_SERVICE=               # staging: laravel-queue-staging | produccion: laravel-queue-prod
DEPLOY_PHP_FPM_SERVICE=php8.3-fpm
DEPLOY_CREATE_DB_BACKUP=false       # produccion: true
DEPLOY_DB_BACKUP_DIR=

# ── STAGING DATA REFRESH (solo staging) ──────────────────────────────────────
STAGING_SANITIZE_PASSWORD=

# ── VITE ──────────────────────────────────────────────────────────────────────
TECH_SHEET_MONTHLY_LIMIT=2
TECH_SHEET_MONTHLY_TIMEZONE=America/Bogota

GOOGLE_ANALYTICS_MEASUREMENT_ID=

VITE_APP_NAME="${APP_NAME}"
